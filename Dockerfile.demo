FROM node:24-alpine AS web
WORKDIR /workspace/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/workspace/backend:/workspace
WORKDIR /workspace/backend
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ ./
COPY demo/ /workspace/demo/
COPY tools/ /workspace/tools/
COPY --from=web /workspace/backend/app/static/react/ ./app/static/react/
RUN useradd --create-home app && mkdir -p /workspace/runtime/uploads /workspace/runtime/image_jobs && chown -R app:app /workspace
USER app
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
