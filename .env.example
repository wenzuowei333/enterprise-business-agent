APP_NAME=项目底座
APP_VERSION=1.0.0
ENVIRONMENT=production
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
INITIAL_ADMIN_REAL_NAME=系统管理员
CORS_ORIGINS=http://192.0.2.1,http://localhost,http://127.0.0.1
POSTGRES_DB=project_base
POSTGRES_USER=project_base
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://project_base:replace-with-a-strong-password@db:5432/project_base
# Exception AI credentials are copied only into the root-owned AI-worker allowlist.
# The exception scheduler and deterministic worker must receive empty HERMES values.
HERMES_API_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=glm-5.2
HERMES_REQUEST_TIMEOUT_SECONDS=120
EXCEPTION_AI_SHUTDOWN_TIMEOUT_SECONDS=150
