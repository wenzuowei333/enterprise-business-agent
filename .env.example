EXCEPTION_AI_SANDBOX_ENABLED=false
EXCEPTION_AI_REMEDIATION_EXECUTION_ENABLED=false
AI_REMEDIATION_PRIVATE_ROOT=../runtime/ai-remediation
AI_REMEDIATION_SCAN_REQUIRED=true
AI_REMEDIATION_SANDBOX_IMAGE=localhost/handmade-ai-sandbox@sha256:disabled
VITE_EXCEPTION_AI_CHAT_ENABLED=true
