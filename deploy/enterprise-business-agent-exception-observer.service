[Unit]
Description=Handmade ERP Exception Dark-Deployment Observer
Requires=enterprise-business-agent-exception-observer-metrics.service
After=enterprise-business-agent-exception-observer-metrics.service

[Service]
Type=oneshot
User=handmade-exception-observer
Group=handmade-exception-observer
SupplementaryGroups=handmade-exception-code
StateDirectory=enterprise-business-agent-exception-release
StateDirectoryMode=0750
WorkingDirectory=/var/lib/enterprise-business-agent-exception-release
Environment=APP_ROOT=/opt/enterprise-business-agent
Environment=OBSERVATION_FILE=/var/lib/enterprise-business-agent-exception-release/dark-observation.json
Environment=OBSERVATION_METRICS_FILE=/run/enterprise-business-agent-exception-observer-metrics/latest.json
Environment=PYTHONPATH=/opt/enterprise-business-agent/backend
ExecStart=/usr/bin/bash /opt/enterprise-business-agent/deploy/record-exception-stage3-observation.sh
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/enterprise-business-agent
ReadOnlyPaths=/run/enterprise-business-agent-exception-observer-metrics
ReadWritePaths=/var/lib/enterprise-business-agent-exception-release
InaccessiblePaths=/opt/enterprise-business-agent/.env
InaccessiblePaths=-/opt/enterprise-business-agent/runtime
InaccessiblePaths=-/opt/enterprise-business-agent/uploads
InaccessiblePaths=-/opt/enterprise-business-agent/attachments
InaccessiblePaths=-/opt/enterprise-business-agent/reports
InaccessiblePaths=-/opt/enterprise-business-agent/backups
InaccessiblePaths=-/opt/enterprise-business-agent/output
InaccessiblePaths=-/opt/enterprise-business-agent/outputs
InaccessiblePaths=-/opt/enterprise-business-agent/.git
InaccessiblePaths=-/opt/enterprise-business-agent/.codex-remote-attachments
UMask=0077
MemoryMax=256M
CPUQuota=50%
TasksMax=32
