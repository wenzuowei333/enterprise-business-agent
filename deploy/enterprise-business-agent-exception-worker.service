[Unit]
Description=Handmade ERP Exception Background Worker
After=network-online.target postgresql.service enterprise-business-agent.service
Wants=network-online.target

[Service]
Type=simple
User=handmade-exception-worker
Group=handmade-exception-worker
SupplementaryGroups=handmade-exception-code
StateDirectory=enterprise-business-agent-exception-worker
StateDirectoryMode=0700
WorkingDirectory=/var/lib/enterprise-business-agent-exception-worker
Environment=PYTHONPATH=/opt/enterprise-business-agent/backend
EnvironmentFile=/etc/enterprise-business-agent/exception-worker.env
EnvironmentFile=/opt/enterprise-business-agent/deploy/exception-non-ai.env
ExecStart=/opt/enterprise-business-agent/.venv/bin/python -m app.tasks.exception_worker
Restart=always
RestartSec=5
TimeoutStopSec=180
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/enterprise-business-agent
InaccessiblePaths=/opt/enterprise-business-agent/.env
InaccessiblePaths=-/opt/enterprise-business-agent/runtime
InaccessiblePaths=-/opt/enterprise-business-agent/uploads
InaccessiblePaths=-/opt/enterprise-business-agent/attachments
InaccessiblePaths=-/opt/enterprise-business-agent/reports
InaccessiblePaths=-/opt/enterprise-business-agent/backups
InaccessiblePaths=-/opt/enterprise-business-agent/output
InaccessiblePaths=-/opt/enterprise-business-agent/outputs
InaccessiblePaths=-/opt/enterprise-business-agent/.git
InaccessiblePaths=-/opt/enterprise-business-agent/.codex-remote-attachments
UMask=0077
MemoryMax=1G
CPUQuota=150%
TasksMax=64

[Install]
WantedBy=multi-user.target
